<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标长按快捷方式（debug 构建专用，见 src/debug/AndroidManifest.xml）。
     targetClass 必须写全限定类名：SyncShortcutActivity 只在 debug 变体存在，
     main 源集不能引用该类，因此该资源放 debug 源集。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="sync-config"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_sync_short"
        android:shortcutLongLabel="@string/shortcut_sync_long"
        android:shortcutDisabledMessage="@string/shortcut_sync_disabled">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="com.agentlray.app.SyncShortcutActivity" />
    </shortcut>
</shortcuts>
